{
  "listen": "127.0.0.1:18080",
  "ethereum_rpc": "http://localhost:8545",
  "solana_rpc": "http://localhost:8899",
  "ipfs_gateways": ["http://localhost:8080"],
  "arweave_gateways": ["http://localhost:1984"],
  "ton_proxy": "",
  "fallback_proxy": "",
  "ccip_read": true,
  "resolve_timeout": "15s",
  "response_header_timeout": "30s",
  "cache_ttl": "60s",
  "negative_cache_ttl": "5s",
  "cache_size": 1024,
  "max_concurrent": 64,
  "https": {
    "enabled": false,
    "ca_cert": "certs/ca.pem",
    "ca_key": "certs/ca-key.pem",
    "connect_ports": [443],
    "handshake_timeout": "10s",
    "tunnel_idle_timeout": "5m",
    "max_tunnels": 64
  }
}
